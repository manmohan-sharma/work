class TestTopExpensesCharacterization:
    """Pin the exact rendering of TopExpensesReport."""

    def test_full_report_output(self, transactions):
        """Top 3 by amount descending, with the 80-char rules."""
        expected = (
            "Top 3 Expenses Report\n"
            "================================================================================\n"
            "Date               Amount Category             Description                   \n"
            "--------------------------------------------------------------------------------\n"
            "2025-03-01 $   1,500.00 Rent                 March rent                    \n"
            "2025-02-03 $     450.00 Electronics          Keyboard                      \n"
            "2025-01-16 $     120.00 Transport            Metro pass                    \n"
            "--------------------------------------------------------------------------------\n"
            "TOTAL (top 3)  $   2,070.00"
        )
        assert TopExpensesReport(top_n=3).process_transactions(transactions) == expected

    def test_fewer_transactions_than_n_appends_note(self, single_transaction):
        """Requesting more rows than exist appends the availability note."""
        output = TopExpensesReport(top_n=5).process_transactions(single_transaction)
        assert output.endswith("Note: Only 1 transaction(s) available")
        assert "TOTAL (top 1)" in output

    def test_long_description_is_truncated(self):
        """Descriptions over 30 chars are cut to 27 plus an ellipsis."""
        long_description = "A" * 50
        txns = [Transaction(date(2025, 1, 1), Decimal('10.00'), 'Food', long_description)]

        output = TopExpensesReport(top_n=1).process_transactions(txns)

        assert ("A" * 27 + "...") in output
        assert ("A" * 28 + "...") not in output

    def test_empty_raises(self):
        with pytest.raises(EmptyDatasetError,
                           match="Cannot generate report from empty transaction list"):
            TopExpensesReport().process_transactions([])

    def test_report_name_includes_n(self):
        assert TopExpensesReport(top_n=7).get_report_name() == "Top 7 Expenses"


class TestSharedStructureCharacterization:
    """
    Pin the properties the Category and Monthly reports have in common.

    These are the invariants a de-duplicating refactor is most likely to break,
    because they are exactly what the two implementations currently duplicate.
    """

    @pytest.mark.parametrize("report_class", [CategorySummaryReport, MonthlyTotalsReport])
    def test_panel_rules_are_50_wide(self, report_class, transactions):
        lines = report_class().process_transactions(transactions).split('\n')
        assert lines[1] == "=" * 50
        assert lines[3] == "-" * 50
        assert lines[-2] == "-" * 50

    @pytest.mark.parametrize("report_class", [CategorySummaryReport, MonthlyTotalsReport])
    def test_total_row_is_last_and_matches_sum(self, report_class, transactions):
        """The grand total equals the sum of the data rows above it."""
        lines = report_class().process_transactions(transactions).split('\n')
        total_line = lines[-1]
        assert total_line.startswith("TOTAL")

        data_rows = lines[4:-2]
        row_sum = sum(Decimal(re.search(r'\$\s*([\d,]+\.\d\d)', row).group(1)
                              .replace(',', ''))
                      for row in data_rows)
        assert row_sum == Decimal('2159.75')
        assert "2,159.75" in total_line

    @pytest.mark.parametrize("report_class", [CategorySummaryReport, MonthlyTotalsReport])
    def test_row_count_matches_group_count(self, report_class, transactions):
        """4 categories, 3 months - one data row each, no blank lines."""
        expected_rows = {CategorySummaryReport: 4, MonthlyTotalsReport: 3}[report_class]
        lines = report_class().process_transactions(transactions).split('\n')
        assert len(lines[4:-2]) == expected_rows
