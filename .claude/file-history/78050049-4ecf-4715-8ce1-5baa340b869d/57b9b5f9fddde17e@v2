"""
Characterization tests for report_mode.py — the refactoring safety net.

These tests do NOT assert that the reports are *correct*. They assert that the
reports are *unchanged*. Every expected value here was captured from the
implementation as it stood before any refactoring, including any quirks.

Why this file exists:
    tests/test_report_modes.py contains 13 test methods, all of which are empty
    `pass` stubs with TODO comments. They report success without executing a
    single line of report_mode.py, which sat at 22% coverage. Refactoring
    against that suite would be unprotected — every report could break while
    the suite stayed green.

    This file is written to be replaced. Once the stubs in test_report_modes.py
    are implemented as real behavioral tests, these characterization tests have
    served their purpose and can go.

Note on the golden strings:
    Full report output is compared byte-for-byte. Substring assertions would not
    catch column misalignment, lost separators or reordered rows — exactly the
    damage a formatting refactor causes.
"""

import re
from datetime import date
from decimal import Decimal

import pytest

from expense_tracker.domain.exceptions import EmptyDatasetError
from expense_tracker.domain.models import Transaction
from expense_tracker.reports.report_mode import (
    CategorySummaryReport,
    MonthlyTotalsReport,
    TopExpensesReport,
)


@pytest.fixture
def transactions():
    """Spans multiple categories, multiple months, and repeated groups."""
    return [
        Transaction(date(2025, 1, 15), Decimal('42.50'), 'Food', 'Lunch'),
        Transaction(date(2025, 1, 16), Decimal('120.00'), 'Transport', 'Metro pass'),
        Transaction(date(2025, 1, 17), Decimal('35.00'), 'Food', 'Groceries'),
        Transaction(date(2025, 2, 3), Decimal('450.00'), 'Electronics', 'Keyboard'),
        Transaction(date(2025, 2, 14), Decimal('12.25'), 'Food', 'Coffee'),
        Transaction(date(2025, 3, 1), Decimal('1500.00'), 'Rent', 'March rent'),
    ]


@pytest.fixture
def single_transaction():
    """Minimum viable dataset: one group, one row."""
    return [Transaction(date(2025, 6, 9), Decimal('9.99'), 'Food', 'Sandwich')]


class TestCategorySummaryCharacterization:
    """Pin the exact rendering of CategorySummaryReport."""

    def test_full_report_output(self, transactions):
        """Complete output, byte-for-byte, sorted by total descending."""
        expected = (
            "Category Summary Report\n"
            "==================================================\n"
            "Category                    Total    Count        Avg\n"
            "--------------------------------------------------\n"
            "Rent                 $   1,500.00        1 $ 1,500.00\n"
            "Electronics          $     450.00        1 $   450.00\n"
            "Transport            $     120.00        1 $   120.00\n"
            "Food                 $      89.75        3 $    29.92\n"
            "--------------------------------------------------\n"
            "TOTAL                $   2,159.75        6 $   359.96"
        )
        assert CategorySummaryReport().process_transactions(transactions) == expected

    def test_single_transaction_output(self, single_transaction):
        """One transaction renders one data row plus the total row."""
        expected = (
            "Category Summary Report\n"
            "==================================================\n"
            "Category                    Total    Count        Avg\n"
            "--------------------------------------------------\n"
            "Food                 $       9.99        1 $     9.99\n"
            "--------------------------------------------------\n"
            "TOTAL                $       9.99        1 $     9.99"
        )
        assert CategorySummaryReport().process_transactions(single_transaction) == expected

    def test_empty_raises(self):
        """Empty input raises EmptyDatasetError with its current message."""
        with pytest.raises(EmptyDatasetError,
                           match="Cannot generate report from empty transaction list"):
            CategorySummaryReport().process_transactions([])

    def test_report_name(self):
        assert CategorySummaryReport().get_report_name() == "Category Summary"


